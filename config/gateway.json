{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "io_threads": 4,
    "max_connections": 20000,
    "idle_timeout_ms": 65000
  },
  "logging": {
    "level": "info",
    "console": true,
    "file": "logs/aegis.log",
    "max_file_bytes": 33554432,
    "max_files": 4
  },
  "limits": {
    "max_header_bytes": 16384,
    "max_body_bytes": 4194304
  },
  "upstreams": [
    {
      "name": "primary",
      "base_url": "https://api.openai.com",
      "api_key_env": "OPENAI_API_KEY",
      "models": ["gpt-4o-mini", "gpt-4o"],
      "weight": 3
    },
    {
      "name": "backup",
      "base_url": "http://127.0.0.1:9001",
      "api_key_env": "BACKUP_API_KEY",
      "models": ["gpt-4o-mini"],
      "weight": 1
    }
  ],
  "rate_limit": {
    "enabled": true,
    "requests_per_second": 20,
    "burst": 40
  },
  "cache": {
    "enabled": true,
    "capacity": 4096,
    "ttl_seconds": 300,
    "semantic": {
      "enabled": false,
      "threshold": 0.92
    }
  },
  "timeouts": {
    "connect_ms": 3000,
    "upstream_ms": 30000
  },
  "gateway_keys": ["sk-local"]
}
